{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vigil.invalid/contract/host-findings-v1.schema.json",
  "title": "host-findings/v1",
  "description": "One POST body of the host-findings format: producer, host, and findings. Owned and published by the vigil repository; field reference in docs/contract/host-findings-v1.md. A receiver accepts its own MAJOR at any MINOR and the whole previous MAJOR.",
  "type": "object",
  "required": [
    "schema_version",
    "batch_id",
    "sent_at",
    "producer",
    "host",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "MAJOR.MINOR of the format, as text. Adding a field or a vocabulary value is MINOR; removing, renaming or retyping one is MAJOR."
    },
    "batch_id": {
      "$ref": "#/$defs/uuid",
      "description": "Idempotency key of the batch; a retry sends the same one."
    },
    "sent_at": {
      "$ref": "#/$defs/timestamp"
    },
    "producer": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "description": "Name and version of the producing agent. A receiver may record it and must not require a particular value."
    },
    "host": {
      "$ref": "#/$defs/host"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "description": "RFC 3339, UTC, milliseconds included. Fixed width: text order is time order, so sorting and windowing need no date parsing."
    },
    "host": {
      "type": "object",
      "required": [
        "host_id",
        "install_id",
        "boot_id",
        "hostname",
        "os"
      ],
      "properties": {
        "host_id": {
          "type": "string",
          "description": "NOT /etc/machine-id: a keyed hash of it under a fixed application id. The field is host_id and the file is /etc/machine-id on purpose: host is what this format calls the node it watches, machine-id is the kernel's name for the file and does not get renamed. Which file the value came from is in tags.host_id_source."
        },
        "install_id": {
          "$ref": "#/$defs/uuid",
          "description": "uuid-v7, minted on first start. Equal host_id and install_id with a different boot_id indicates a cloned image."
        },
        "boot_id": {
          "type": "string"
        },
        "hostname": {
          "type": "string"
        },
        "fqdn": {
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "type": "object",
          "required": [
            "family",
            "distro",
            "version",
            "kernel",
            "arch"
          ],
          "properties": {
            "family": {
              "type": "string"
            },
            "distro": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "kernel": {
              "type": "string"
            },
            "arch": {
              "type": "string"
            }
          }
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "peer": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "event_id",
        "finding_key",
        "kind",
        "severity",
        "state",
        "observed_at",
        "first_seen_at",
        "occurrences",
        "title",
        "subject"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/uuid",
          "description": "Identifies THIS record. Idempotency key: minted once, reused by every retry."
        },
        "finding_key": {
          "type": "string",
          "description": "Identifies the OBJECT being watched. Repeats collapse onto it; suppressions are keyed by it."
        },
        "kind": {
          "type": "string",
          "description": "One of the values below, or any other string. An unknown value is stored and shown as received, not dropped.",
          "examples": [
            "port.listen.new",
            "port.listen.removed",
            "port.listen.exposed",
            "port.listen.owner_changed",
            "user.account.new",
            "user.account.removed",
            "user.account.uid0",
            "user.account.unlocked",
            "user.group.privileged_member_added",
            "user.sshkey.added",
            "user.sshkey.removed",
            "user.password.changed",
            "auth.failure.burst",
            "auth.success_after_burst",
            "auth.new_source",
            "auth.sudo.used",
            "auth.su.used",
            "process.unexpected_parent",
            "process.from_writable_path",
            "process.binary_deleted",
            "process.root.new",
            "exec.first_seen_for_user",
            "exec.from_writable_path",
            "file.changed",
            "file.permissions_changed",
            "file.suid.new",
            "file.path_writable_by_all",
            "file.sshd_config.weakened",
            "file.mac_mode_changed",
            "persistence.unit.new",
            "persistence.timer.new",
            "persistence.cron.new",
            "persistence.preload_changed",
            "persistence.kernel_module.loaded",
            "persistence.shell_profile_changed",
            "firewall.disabled",
            "firewall.enabled",
            "firewall.ruleset_flushed",
            "firewall.policy_weakened",
            "container.privileged",
            "container.host_mount",
            "container.docker_socket_exposed",
            "container.image_unknown",
            "resource.disk_low",
            "resource.inode_low",
            "resource.reboot",
            "resource.clock_skew",
            "agent.baseline.ready",
            "agent.collector.degraded",
            "agent.collector.recovered",
            "agent.buffer.dropping",
            "agent.buffer.drained",
            "agent.budget.exceeded",
            "agent.budget.recovered",
            "agent.clone_suspected",
            "agent.store.damaged",
            "agent.receiver_refused"
          ]
        },
        "severity": {
          "type": "string",
          "description": "One of the five below, or any other string, preserved as an unknown kind is.",
          "examples": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "state": {
          "enum": [
            "open",
            "resolved"
          ],
          "description": "Closed vocabulary: open or resolved only."
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "first_seen_at": {
          "$ref": "#/$defs/timestamp"
        },
        "occurrences": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "subject": {
          "type": "object",
          "required": [
            "type",
            "key"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "key": {}
          }
        },
        "before": {},
        "after": {},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "redacted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "JSON pointers of fields scrubbed on the agent before anything was written to disk. A listed field is hidden, not absent."
        },
        "rule": {
          "type": [
            "string",
            "null"
          ]
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
