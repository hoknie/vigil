<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>vigil.vigild</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/sbin/vigild</string>
		<string>/usr/local/etc/vigil/vigil.yaml</string>
	</array>
	<key>UserName</key>
	<string>root</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>ExitTimeOut</key>
	<integer>15</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>/usr/local/var/log/vigil/vigild.log</string>
	<key>StandardErrorPath</key>
	<string>/usr/local/var/log/vigil/vigild.log</string>
</dict>
</plist>
