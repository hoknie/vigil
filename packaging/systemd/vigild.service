[Unit]
Description=vigil host protection agent
Documentation=file:/usr/share/doc/vigil/README.md

After=network.target
After=systemd-journald-dev-log.socket syslog.socket

# The firewall reading is taken by a unit of its own, because reading the nftables ruleset
# needs a privilege this daemon is not given. Wants= starts it with the agent; to stop the
# reading without stopping the agent: systemctl mask vigil-firewall.timer
Wants=vigil-firewall.timer

StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
ExecStart=/usr/sbin/vigild /etc/vigil/vigil.yaml
KillSignal=SIGTERM
TimeoutStopSec=15s

Restart=always
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=vigild

StateDirectory=vigil
StateDirectoryMode=0700
RuntimeDirectory=vigil
RuntimeDirectoryMode=0700
LogsDirectory=vigil
LogsDirectoryMode=0700

User=root
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
NoNewPrivileges=yes
UMask=0077

ProtectHome=read-only
ProtectProc=default
ProcSubset=all

ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

PrivateTmp=yes
PrivateDevices=yes

PrivateNetwork=no
PrivateUsers=no

RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

SystemCallErrorNumber=EPERM

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

MemoryHigh=64M
MemoryMax=192M
TasksMax=32

[Install]
WantedBy=multi-user.target
