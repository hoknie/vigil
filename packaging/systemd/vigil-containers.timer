[Unit]
# How often this host's container engines are asked what they hold. Each file the dump
# writes names the moment of the one before it, and the agent calls the reading stale once it
# is older than two of the periods the files show, so the period is changed here and nowhere
# else:
#
#     systemctl edit vigil-containers.timer    OnUnitActiveSec= sets the period
#     systemctl mask vigil-containers.timer    stop the reading, keep the package
#
# Until two dumps have shown a period, the agent assumes dump_seconds from the
# containers-engines block of /etc/vigil/collectors/containers.yaml (120 unless it says
# otherwise).
# A period lengthened to more than twice the old one may be called stale once, until the next
# dump shows it.
#
# vigild.service pulls this timer in with Wants=, so enabling the agent enables the reading
# and masking the timer switches it off without touching the agent.
Description=vigil: read what this host's container engines hold, every two minutes
Documentation=file:/usr/share/doc/vigil/README.md

[Timer]
OnBootSec=45s
OnUnitActiveSec=120s
AccuracySec=10s
Unit=vigil-containers.service

[Install]
WantedBy=timers.target
