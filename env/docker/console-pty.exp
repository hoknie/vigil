#!/usr/bin/expect -f

set console [lindex $argv 0]
if {$console eq ""} { set console "/build/target/debug/vigil" }

set timeout 15
set failures 0

set env(COLUMNS) 140
set env(LINES) 30
set env(TERM) xterm-256color
stty rows 30 columns 140

proc note {what} { puts "  ·  $what" }

proc repaint {} {
    global spawn_out
    catch { exec stty rows 29 columns 140 < $spawn_out(slave,name) }
    after 250
    catch { exec stty rows 30 columns 140 < $spawn_out(slave,name) }
    after 250
}

proc drawn {{seconds 2}} {
    global spawn_id
    repaint
    set text ""
    set deadline [expr {[clock seconds] + $seconds}]
    while {[clock seconds] < $deadline} {
        set timeout 1
        expect {
            -re {.+} { append text $expect_out(buffer) }
            timeout {}
            eof { break }
        }
    }
    regsub -all {\x1b\[[0-9;?]*[a-zA-Z]} $text "" text
    regsub -all {\x1b\][^\x07]*\x07} $text "" text
    regsub -all {\x1b[()][A-Za-z0-9]} $text "" text
    regsub -all {\x1b[=>]} $text "" text
    return $text
}

proc settle {} { drawn 2 }

proc steady {{seconds 3}} {
    drawn 1
    return [drawn $seconds]
}

proc squash {text} {
    regsub -all {[ \t]+} $text "" text
    return $text
}

proc check_loose {what haystack needle} {
    check $what [squash $haystack] [squash $needle]
}

proc check_absent_loose {what haystack needle} {
    check_absent $what [squash $haystack] [squash $needle]
}

proc check {what haystack needle} {
    global failures
    if {[string first $needle $haystack] >= 0} {
        puts "  ok   $what"
    } else {
        incr failures
        puts "  FAIL $what · did not find: $needle"
        puts "-------- what the console drew --------"
        puts $haystack
        puts "---------------------------------------"
    }
}

proc check_either_loose {what haystack first second} {
    global failures
    set page [squash $haystack]
    if {[string first [squash $first] $page] >= 0 || [string first [squash $second] $page] >= 0} {
        puts "  ok   $what"
    } else {
        incr failures
        puts "  FAIL $what · found neither: $first · nor: $second"
        puts "-------- what the console drew --------"
        puts $haystack
        puts "---------------------------------------"
    }
}

proc check_absent {what haystack needle} {
    global failures
    if {[string first $needle $haystack] < 0} {
        puts "  ok   $what"
    } else {
        incr failures
        puts "  FAIL $what · found what must be absent: $needle"
        puts "-------- what the console drew --------"
        puts $haystack
        puts "---------------------------------------"
    }
}

set Down   "\033\[B"
set Up     "\033\[A"
set Right  "\033\[C"
set Left   "\033\[D"
set Enter  "\r"
set Esc    "\033"

proc printed {command} {
    set text ""
    spawn -noecho {*}$command
    expect {
        -re {.+} { append text $expect_out(buffer); exp_continue }
        eof {}
        timeout {}
    }
    catch wait
    return $text
}

proc alive {process} {
    return [file exists "/proc/$process"]
}

proc opened_port {} {
    for {set tries 0} {$tries < 6} {incr tries} {
        set port [expr {20000 + ([clock milliseconds] + [pid] + $tries * 1013) % 30000}]
        if {[catch { exec nc -l -p $port < /dev/null > /dev/null 2> /dev/null & } listener]} {
            continue
        }
        after 800
        if {[alive $listener]} { return [list $port $listener] }
    }
    return [list 0 0]
}

proc waiting_for {needle {seconds 120}} {
    set wanted [squash $needle]
    set deadline [expr {[clock seconds] + $seconds}]
    set page [drawn 3]
    while {[string first $wanted [squash $page]] < 0 && [clock seconds] < $deadline} {
        set page [drawn 3]
    }
    return $page
}

note "the help is coloured under a terminal, and plain under NO_COLOR"
foreach program [list $console [file join [file dirname $console] vigild]] {
    if {![file executable $program]} { continue }
    set name [file tail $program]

    set coloured [printed [list $program --help]]
    check "$name --help prints how it is used" $coloured "Usage:"
    if {[string first "\x1b\[" $coloured] >= 0} {
        puts "  ok   $name --help is coloured under a terminal"
    } else {
        incr failures
        puts "  FAIL $name --help has no colour in it under a terminal"
    }

    set env(NO_COLOR) 1
    set plain [printed [list $program --help]]
    unset env(NO_COLOR)
    if {[string first "\x1b\[" $plain] < 0} {
        puts "  ok   $name --help adds nothing at all under NO_COLOR"
    } else {
        incr failures
        puts "  FAIL $name --help still writes escapes under NO_COLOR"
    }

    set stripped $coloured
    regsub -all {\x1b\[[0-9;?]*[a-zA-Z]} $stripped "" stripped
    check "$name --help reads the same with the colour stripped" [squash $stripped] [squash $plain]
}

note "a listening port is opened before the console starts, for the agent to find"
set opened [opened_port]
set port [lindex $opened 0]
set listener [lindex $opened 1]
if {$port == 0} {
    incr failures
    puts "  FAIL no port could be opened here, so the trail from a finding cannot be walked"
} else {
    puts "  ok   :$port is listening, held by nc $listener"
}

puts "spawning $console under a pseudo-terminal"
spawn $console ui
match_max 400000
settle

note "the console opens on the main screen, with the cursor on a section"
set page [drawn]
check_loose "the main screen is the one that opens" $page "▸ What this agent watches"
check_loose "it names what the agent reads" $page "WHAT IT READS"
check_loose "and what it makes of it" $page "WHAT IT CONCLUDES"
check "the cursor is on a row" $page " > "
check_loose "the footer names the range that opens something" $page "1 - 9"
check_absent_loose "and the row of screen names along the top is gone" $page "▸ 1 summary"

note "a section's row carries its number, how many objects and when it last read"
check_loose "network is the first section" $page "1 network"
check_loose "accounts is the second" $page "2 accounts"
check_loose "programs is the third" $page "3 programs"
check_loose "startup is the fourth" $page "4 startup"
check_loose "firewall is the fifth" $page "5 firewall"
check_loose "the system is the sixth" $page "6 system"
check_loose "containers is the seventh" $page "7 containers"
check_loose "summary is the eighth" $page "8 summary"
check_loose "findings is the ninth" $page "9 findings"
check_loose "and the table says what each row holds" $page "WHATITHOLDS"

note "/ on the main screen says where the search lives and does not move the reader"
send "/"
set page [drawn]
check_loose "it says where search belongs" $page "open one and press /"
check_loose "and the main screen is still the one open" $page "▸ What this agent watches"

note "3: programs, opened by the number drawn on its row"
send "3"
set page [drawn 3]
check_loose "the section opened" $page "▸ What has run here"
check_loose "and the caret is on its row of lists" $page "▸ \[running\] · launches"

note "→: the second list, which this host has nothing to fill from"
send $Right
set page [steady 3]
check_loose "the second list is open" $page "running · \[launches\]"
check_loose "the list itself says the reading was refused" $page "This reading was refused: launches is unavailable."
check_loose "in the words the agent used" $page "auditd is not running"
check_loose "naming the file it went to" $page "/var/log/audit/audit.log"
check_loose "and what is missing because of it" $page "No launch is listed here"
check_absent_loose "rather than promising a reading that is on its way" $page "The agent has not taken this reading yet."
check_absent_loose "or a first one due within the period" $page "The first one is due within the period"
check_absent_loose "so there is no empty table under it" $page "WHO PROGRAM FIRST SEEN"
check_loose "and the screen says a collector here is not reading everything" $page "not reading everything"

note "←, ↓, →: back to the list the collector fills, into it, into the detail of a row"
send $Left
set page [drawn 3]
check_loose "the first list is open again" $page "▸ \[running\] · launches"
check_loose "and it says what it is" $page "one row per program found running, and as whom"
send $Down
set page [drawn 3]
check "the cursor is on a row" $page " > "
send $Right
set page [drawn 3]
check_loose "the detail of a program opened" $page "▸ THE SELECTED PROGRAM"
send "G"
set page [drawn 3]
check_loose "and G reaches the suppression at the end of it" $page "suppressions:"

note "2 from the detail: a number works from every rung"
send "2"
set page [steady 3]
check_loose "the accounts section opened" $page "▸ Who can log in"
check_loose "on its top rung, the row of lists" $page "▸ \[users\]"
check_absent_loose "and not in a detail" $page "THE SELECTED PROGRAM"

note "→ five times: the last of the accounts lists, who is logged in"
for {set step 0} {$step < 5} {incr step} {
    send $Right
    after 200
}
set page [steady 3]
check_loose "the last list is open" $page "\[logged in\]"
check_loose "and it says what it reads" $page "login records"
check_loose "the table names who saw each row" $page "SEEN BY"
check_loose "this workbench keeps no utmp, and the row says so" $page "/run/utmp"
check_loose "nor does logind run here" $page "/run/systemd/sessions"
check_loose "and each of them is named a source that is not on this host" $page "loginsource,notonthishost"
check_loose "the tally says it too, rather than leaving a blank list to speak" $page "logind:notonthishost"
check_absent_loose "and nothing here reads as a host nobody has logged in to" $page "Nobodyisloggedin"
send $Left
after 200
send $Left
after 200
send $Left
after 200
send $Left
after 200
send $Left
set page [steady 3]
check_loose "and ← comes back along the row to the first list" $page "\[users\]"

note "Esc from the top rung of a section: the main screen, cursor where it was left"
send $Esc
set page [drawn 3]
check_loose "the main screen is back" $page "▸ What this agent watches"
check_loose "with the cursor on the section just left" $page "> ! 2 accounts"

note "↓ ↓, Enter, →: down to startup, into it, along its lists"
send $Down
after 200
send $Down
set page [drawn 3]
check_loose "the cursor moved down the sections" $page "> 4 startup"
send $Enter
set page [drawn 3]
check_loose "the section opened" $page "▸ What starts by itself"
check_loose "and its five lists are on the screen" $page "\[units\] · timers · cron · modules · files"
send $Right
set page [drawn 3]
check_loose "the second list is open" $page "\[timers\]"
check_loose "and it says what it is" $page "every systemd timer"

note "Esc twice: out of the list and out of the section"
send $Esc
after 300
send $Esc
after 300
set page [drawn 3]
check_loose "the main screen is back" $page "▸ What this agent watches"
check_loose "and every section row carries a state" $page "STATE"

note "5: the firewall, which this workbench has a live nft to read"
send "5"
set page [drawn 3]
check_loose "the firewall section opened" $page "▸ What the host lets in"
check_loose "and it says what a policy means on it" $page "POLICY"

note "9: the findings, narrowed to the port opened for this run"
send "9"
set page [drawn 3]
check_loose "the findings section opened" $page "▸ What the agent has found"
send "/"
foreach digit [split $port ""] {
    send $digit
    after 80
}
send $Enter
set page [waiting_for "port.listen|tcp|0.0.0.0:$port"]
check_loose "the agent noticed the port that was opened while it watched" $page "port.listen.new"
check_loose "and the object it names is that socket" $page "port.listen|tcp|0.0.0.0:$port"
check_loose "the search holds the rest of them back" $page "matching \"$port\""
check "and the cursor is on the one row left" $page " > "

note "o: onto the socket the finding is about"
send "o"
set page [drawn 3]
check_loose "the section that holds the object opened" $page "▸ What is listening"
check_loose "the sockets themselves are what it holds" $page "PROTO ADDRESS USER PROGRAM"
check_loose "and the cursor is on the socket the finding named" $page "> tcp 0.0.0.0:$port"
check_loose "and the hint names where Esc goes now" $page "back to the finding"

note "Esc from there: back to the finding it was pressed on"
send $Esc
set page [steady 3]
check_loose "the findings are back" $page "▸ What the agent has found"
check_loose "on the finding o was pressed on" $page "port.listen|tcp|0.0.0.0:$port"
check "and the cursor is on a row" $page " > "
check_absent_loose "and the hint no longer promises a finding" $page "back to the finding"

note "Esc again: the trail is spent, so this one puts the search down"
send $Esc
set page [steady 3]
check_loose "the findings are still the screen open" $page "▸ What the agent has found"
check_absent_loose "with nothing held back any more" $page "matching \"$port\""
check_loose "and what the search hid is back" $page "agent.collector.degraded"

note "Esc once more: nothing left to undo, so this one is the ladder, up to the row of lists"
send $Esc
set page [drawn 2]
check_loose "the row of the findings' two lists" $page "▸ \[reported\] · silenced"

note "→ along that row: the list of what this host silences"
send $Right
set page [drawn 2]
check_loose "the second list is chosen" $page "reported · \[silenced\]"
check_loose "and it says where each entry stands" $page "STANDING"
send $Left

note "Esc from the row of lists: the main screen"
send $Esc
set page [drawn 2]
check_loose "the main screen" $page "▸ What this agent watches"

note "9, ↓, →: a finding and its detail, side by side on a terminal wide enough for both"
send "9"
after 400
send $Down
after 200
send $Right
set page [drawn 2]
check_loose "the detail of the finding opened" $page "THE SELECTED FINDING"
check_loose "and the hint names one meaning for both keys back" $page "← or Esc back to the list"
check_absent_loose "and not one meaning each" $page "← close it"

note "← once: the focus goes to the list and the panel stays beside it"
send $Left
set page [drawn 2]
check_loose "the panel is still drawn" $page "THE SELECTED FINDING"
check_loose "the findings are still the screen open" $page "▸ What the agent has found"
check_loose "and the hint says what the next press does" $page "← or Esc close the panel"

note "← twice: the panel goes away and the list has the width to itself"
send $Left
set page [drawn 2]
check_absent_loose "the panel is off the screen" $page "THE SELECTED FINDING"
check_loose "and the findings are still the screen open" $page "▸ What the agent has found"
check_absent_loose "that press was one step, not two" $page "▸ What this agent watches"

note "← three times: the rung above the list is the row of the findings' lists"
send $Left
set page [drawn 2]
check_loose "the row of lists" $page "▸ \[reported\] · silenced"
check_absent_loose "and not the main screen yet" $page "WHAT IT CONCLUDES"

send $Esc
set page [drawn 2]
check_loose "Esc from there is the main screen" $page "▸ What this agent watches"

note "the port opened for this run is closed behind it"
catch { exec kill $listener }

note "1, /: the search belongs to the list the reader is in"
send "1"
after 400
send "/"
set page [drawn 3]
check_loose "the box opened on the network, where the reader was" $page "every value the agent read"
check_loose "and did not move them to the findings" $page "▸ What is listening"
send "nginxq"
after 300
send "\177"
set page [drawn 3]
check "the list narrowed to the rows that match" $page "nginx"
check_loose "and the console did not quit on that q" $page "sockets"
send $Esc
after 300
set page [drawn 3]
check "the rows are back" $page "PROTO"

note "→: the detail of a socket, with the whole path the table cut"
send $Right
set page [drawn 3]
check_loose "the socket detail opened" $page "▸ THE SELECTED SOCKET"
check "with the suppression to copy" $page "suppressions:"

note "Tab does nothing at all: the row it walked no longer exists"
send $Esc
after 300
send $Esc
after 300
send $Esc
after 300
send $Esc
after 300
set before [drawn 3]
check_loose "four presses out of the socket detail is the main screen" $before "▸ What this agent watches"
send "\t"
set after [drawn 3]
check_loose "the main screen did not move under Tab" $after "▸ What this agent watches"
check_absent_loose "and Tab did not open a section" $after "▸ What is listening"

note "6: the section that holds two readings of this host"
send "6"
set page [drawn 3]
check_loose "the section opened" $page "▸ The host and the files watched on it"
check_loose "and both of its readings are named on it" $page "\[the host\] · watched files"
send $Down
set page [drawn 3]
check_loose "the host is read as boot, memory and the filesystems under it" $page "KIND"
check_loose "and how full a filesystem is is drawn in the steps the agent reads it in" $page "FREE"
send $Esc
after 300
send $Right
set page [drawn 3]
check_loose "→ along the row of names opens the other reading" $page "\[watched files\]"
check_loose "and the watched paths carry their mode and their owner" $page "MODE"

note "7: what is running in containers, whether or not this host sees itself as one"
send "7"
set page [drawn 3]
check_loose "the section opened" $page "▸ What is running in containers"
check_either_loose "and drew one of the two answers a host can give" $page \
    "CONTAINER  PROGRAM" "Nothing is running in a container on this host"
check_either_loose "the runtime socket is named under the table, or said not to be there" \
    $page "socket /" "no runtime socket on this host"
check_absent_loose "and no column is there for the socket rows this table no longer draws" \
    $page "MODE OWNER"
if {[string first "0container(s)" [squash $page]] < 0} {
    note "this workbench can see itself as a container, so the table is drawn"
    check_loose "the columns are the ones a container has" $page "CONTAINER  PROGRAM"
    check_loose "and SYS_ADMIN is one of them" $page "SYS_ADMIN"
} else {
    note "this workbench cannot see itself as a container: the named screen is the answer"
}

note "↑ from the first row of a section with no row of lists: the main screen"
send $Up
set page [drawn 3]
check_loose "the arrows are the way out as much as the way down" $page "▸ What this agent watches"

note "8: the summary, and what is kept on disk"
send "8"
set page [drawn 3]
check_loose "the summary opened" $page "▸ This host and its agent"
check_loose "the collectors table says how often each one reads" $page "EVERY"
for {set scrolled 0} {$scrolled < 8} {incr scrolled} { send "j" }
set page [drawn 3]
check_loose "and a screenful down there is a place for what is kept on disk" $page "WHATISKEPTONDISK"
check_loose "and the receivers say what is waiting for each of them" $page "WAITING"

note "j: to the foot of the summary, where the agent says what it holds back"
for {set scrolled 0} {$scrolled < 30} {incr scrolled} { send "j" }
set page [drawn 3]
check_loose "the foot of the summary is what the agent is not saying" $page "WHATISNOTBEINGSAID"

note "q: the console leaves and gives the terminal back"
send "q"
set parting ""
expect {
    -re {.+} { append parting $expect_out(buffer); exp_continue }
    eof {}
    timeout {
        incr failures
        puts "  FAIL the console did not exit on q"
    }
}
if {[string first "\x1b\[?1049l" $parting] >= 0} {
    puts "  ok   it left the alternate screen behind it"
} else {
    incr failures
    puts "  FAIL it did not restore the terminal on the way out"
}

catch wait result
set code [lindex $result 3]
if {$code == 0} {
    puts "  ok   it exited 0"
} else {
    incr failures
    puts "  FAIL it exited $code"
}

catch { exec kill $listener }

note "a second agent is started over a small tree of unit files, to drive the units view"
catch { exec sh -c {
rm -rf /tmp/vigil-tree
mkdir -p /tmp/vigil-tree /etc/systemd/system
printf '[Unit]\nDescription=Multi-User System\n' > /etc/systemd/system/multi-user.target
printf '[Unit]\nDescription=Web server\n[Service]\nExecStart=/usr/sbin/nginx\n[Install]\nWantedBy=multi-user.target\n' > /etc/systemd/system/nginx.service
printf '[Unit]\nDescription=Key value store\n[Service]\nExecStart=/usr/bin/redis-server\n[Install]\nWantedBy=multi-user.target\n' > /etc/systemd/system/redis.service
printf '[Unit]\nDescription=Sidecar of the web server\nPartOf=nginx.service\n[Service]\nExecStart=/usr/bin/sidecar\n' > /etc/systemd/system/sidecar.service
printf '[Unit]\nDescription=Nothing pulls this one in\n[Service]\nExecStart=/bin/sh\n' > /etc/systemd/system/lonely.service
printf 'state_dir: /tmp/vigil-tree\nsocket_path: /tmp/vigil-tree/vigil.sock\nretention_days: 1\ninterval_seconds: 5\ncollectors:\n  - persistence\nschedule:\n  persistence: 5\nsuppressions: []\nlaunches:\n  record_arguments: false\nreporters: []\n' > /tmp/vigil-tree/vigil.yaml
} } seeding

set daemon 0
if {[catch { exec /build/target/debug/vigild /tmp/vigil-tree/vigil.yaml > /tmp/vigil-tree/log 2>@1 & } daemon]} {
    incr failures
    puts "  FAIL the second agent would not start: $daemon"
    set daemon 0
} else {
    after 4000
    puts "  ok   a second agent is watching /etc/systemd/system, pid $daemon"
}

spawn $console ui --socket /tmp/vigil-tree/vigil.sock
match_max 400000
settle

note "4, ↓: the startup section and its units, drawn as the list"
send "4"
after 600
send $Down
set page [waiting_for "nginx.service" 40]
check_loose "the units list is the one open" $page "\[units\] · timers"
check_loose "and the key that switches the view is drawn beside it" $page "\[t list\] t tree"
check "nginx is a row of it" $page "nginx.service"
check_loose "and the rows are in the order of the alphabet" $page "nginx.service Web server │ │ redis.service"

note "↓ ↓ ↓: the cursor onto the third unit down"
send $Down
after 200
send $Down
after 200
send $Down
set page [drawn 3]
check "the cursor is on redis" $page " > redis.service"

note "t: the same units, drawn as the tree the files describe"
send "t"
set page [drawn 3]
check_loose "the view switched" $page "t list \[t tree\]"
check_loose "and it says which of the two answers it draws" $page "as written in the files"
check "the reader is still on the same unit, one level in under its target" $page " >   redis.service"
check_loose "what a unit pulls in comes directly under it" $page "nginx.service Web server │ │ sidecar.service"
check "a unit nothing pulls in is still a row" $page "lonely.service"
check_loose "and the footer counts the same units the list counted" $page "5 units of"

note "t again: back to the list, and the reader has not moved"
send "t"
set page [drawn 3]
check_loose "the view switched back" $page "\[t list\] t tree"
check "the reader is still on the same unit, with no indent now" $page " > redis.service"
check_loose "and the rows are in the order of the alphabet again" $page "nginx.service Web server │ │ > redis.service"

note "8: the summary of an agent whose configuration names one collector out of five"
send "8"
set page [waiting_for "COLLECTORS" 20]
check_loose "a collector that is off is marked as having something to say" $page "! launches"
check_absent_loose "and says nothing under the row until it is asked" $page "notfailing"
send "d"
set page [drawn 3]
check_loose "d unfolds what the row has to say" $page "collectors:"
check_loose "and says that being off is a decision and not a failure" $page "notfailing"

send "q"
expect {
    -re {.+} { exp_continue }
    eof {}
    timeout { incr failures; puts "  FAIL the second console did not exit on q" }
}
catch wait
if {$daemon != 0} { catch { exec kill $daemon } }


puts ""
if {$failures == 0} {
    puts "console-pty: ok, driven under a real terminal"
    exit 0
}
puts "console-pty: $failures check(s) failed"
exit 1
